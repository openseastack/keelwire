{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keelwire",
  "version": "0.1.0",
  "identifier": "org.keelwire.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Open-source NMEA 2000 analyzer",
    "longDescription": "NMEA 2000 bus analysis, diagnostics and device configuration.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "section": "electronics"
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 140,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 190
        }
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "keelwire"
        ],
        "name": "Keelwire boat file",
        "description": "NMEA 2000 network snapshot",
        "role": "Viewer",
        "mimeType": "application/x-keelwire"
      }
    ],
    "publisher": "Keelwire contributors",
    "copyright": "Apache-2.0. Includes the CANboat PGN database (Apache-2.0).",
    "homepage": "https://github.com/openseastack/keelwire",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}
