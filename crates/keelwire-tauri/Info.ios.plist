<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the generated iOS Info.plist by `tauri ios build/dev` (docs/IOS-SPEC.md §5). -->
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Keelwire connects to your NMEA 2000 Wi-Fi gateway on the boat's network.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The interface is served by the app itself on 127.0.0.1 over plain HTTP. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Sessions and reports appear in Files › On My iPhone/iPad › Keelwire. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
</dict>
</plist>
